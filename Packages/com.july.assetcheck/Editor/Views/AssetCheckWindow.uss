.asset-check {
    flex-grow: 1;
    padding-bottom: 4px;
    font-size: 12px;
    color: var(--ac-text);
    background-color: var(--ac-bg);
}
.asset-check.theme-dark {
    --ac-bg: #2c2c2c;
    --ac-surface: #333333;
    --ac-row: #303030;
    --ac-row-alt: #343434;
    --ac-line: #454545;
    --ac-text: #e3e3e3;
    --ac-muted: #aaaaaa;
    --ac-accent: #6aa8e8;
    --ac-primary: #386fa6;
    --ac-primary-hover: #427fb9;
}
.asset-check.theme-light {
    --ac-bg: #e7e7e7;
    --ac-surface: #f2f2f2;
    --ac-row: #eeeeee;
    --ac-row-alt: #e8e8e8;
    --ac-line: #c3c3c3;
    --ac-text: #2b2b2b;
    --ac-muted: #666666;
    --ac-accent: #2466a5;
    --ac-primary: #3974ad;
    --ac-primary-hover: #2e659b;
}
.asset-check Button { height: 22px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; }
.asset-check .header { flex-direction: row; align-items: center; height: 42px; flex-shrink: 0; padding: 5px 10px; background-color: var(--ac-surface); border-bottom-width: 1px; border-bottom-color: var(--ac-line); }
.asset-check .header > Label { -unity-text-align: middle-left; color: var(--ac-muted); margin-left: 8px; }
.asset-check .header .header-action { height: 26px; flex-shrink: 0; margin: 0 0 0 5px; padding: 0 12px; -unity-text-align: middle-center; }
.asset-check .header .settings-action { height: 26px; flex-shrink: 0; margin-left: 6px; padding: 0 8px; align-items: center; justify-content: center; }
.asset-check .settings-action .unity-toolbar-menu__text { -unity-text-align: middle-center; }
.asset-check .header .primary { background-color: var(--ac-primary); color: white; -unity-font-style: bold; border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; margin-left: 12px; }
.asset-check .header .primary:hover { background-color: var(--ac-primary-hover); }
.asset-check .platform { width: 154px; margin-right: 8px; }
.asset-check .platform > .unity-base-field__label { min-width: 30px; }
.asset-check .scope { flex-grow: 1; flex-shrink: 1; min-width: 55px; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; color: var(--ac-text); }
.asset-check .type-tabs { flex-direction: row; align-items: center; height: 40px; flex-shrink: 0; padding: 4px 10px; background-color: var(--ac-bg); border-bottom-width: 1px; border-bottom-color: var(--ac-line); }
.asset-check .type-tabs .type-tab { flex-direction: row; align-items: center; justify-content: center; min-width: 102px; height: 30px; flex-shrink: 0; margin: 0 4px 0 0; padding: 0 10px; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: transparent; border-bottom-color: transparent; border-left-color: transparent; border-right-color: transparent; background-color: transparent; }
.asset-check .type-tab:hover { background-color: var(--ac-surface); }
.asset-check .type-tabs .type-tab.active { background-color: var(--ac-surface); border-top-color: var(--ac-line); border-bottom-color: var(--ac-accent); border-left-color: var(--ac-line); border-right-color: var(--ac-line); }
.asset-check .tab-title { margin: 0; -unity-text-align: middle-center; color: var(--ac-muted); }
.asset-check .type-tab.active .tab-title { color: var(--ac-accent); -unity-font-style: bold; }
.asset-check .tab-count { min-width: 19px; height: 18px; margin: 0 0 0 7px; padding: 0 4px; -unity-text-align: middle-center; font-size: 10px; color: var(--ac-muted); background-color: var(--ac-row-alt); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
.asset-check .type-tab.active .tab-count { color: var(--ac-accent); }
.asset-check .tab-count.zero { background-color: transparent; }
.asset-check .overview { flex-shrink: 0; margin: 0 12px; padding-top: 9px; padding-bottom: 7px; border-bottom-width: 1px; border-bottom-color: var(--ac-line); }
.asset-check .metrics { flex-direction: row; align-items: center; }
.asset-check .metric { width: 112px; }
.asset-check .metric-value { font-size: 20px; -unity-font-style: bold; margin: 0; color: var(--ac-text); }
.asset-check .metric-caption { color: var(--ac-muted); font-size: 11px; margin: 2px 0 0; }
.asset-check .scan-metadata { flex-grow: 1; -unity-text-align: middle-right; color: var(--ac-muted); white-space: normal; font-size: 11px; }
.asset-check .report-state { margin: 7px 0 0; padding: 4px 7px; background-color: var(--ac-surface); border-left-width: 2px; border-left-color: var(--ac-accent); color: var(--ac-text); white-space: normal; font-size: 11px; }
.asset-check .standards { flex-shrink: 0; min-height: 24px; margin: 4px 12px 0; padding: 2px 0; }
.asset-check .standard-fields { flex-direction: row; flex-wrap: wrap; padding-top: 6px; padding-bottom: 6px; }
.asset-check .standard-field { width: 260px; margin-right: 14px; margin-bottom: 5px; }
.asset-check .standard-field > .unity-base-field__label { min-width: 124px; }
.asset-check .report-bar { flex-direction: row; align-items: center; padding: 2px 10px; height: 30px; flex-shrink: 0; }
.asset-check .report-bar > Button { margin-right: 6px; padding-left: 10px; padding-right: 10px; }
.asset-check .help { margin-left: 3px; color: var(--ac-muted); width: 20px; -unity-text-align: middle-center; }
.asset-check .result-controls { flex-direction: row; align-items: center; height: 30px; flex-shrink: 0; margin: 0 12px 5px; }
.asset-check .result-controls > .unity-base-popup-field { width: 226px; margin-right: 10px; }
.asset-check .result-controls .unity-base-field__label { min-width: 52px; color: var(--ac-muted); }
.asset-check .result-controls > Button { margin-right: 5px; padding: 0 10px; -unity-text-align: middle-center; }
.asset-check .result-counts { flex-grow: 1; min-width: 90px; -unity-text-align: middle-right; color: var(--ac-muted); font-size: 11px; }
.asset-check .results { flex-grow: 1; min-height: 80px; margin: 0 12px; background-color: var(--ac-row); border-top-width: 1px; border-top-color: var(--ac-line); border-bottom-width: 1px; border-bottom-color: var(--ac-line); }
.asset-check .results .unity-collection-view__item--alternative-background { background-color: var(--ac-row-alt); }
.asset-check .cell { -unity-text-align: middle-left; padding-left: 7px; padding-right: 5px; overflow: hidden; text-overflow: ellipsis; white-space: normal; color: var(--ac-text); }
.asset-check .resource-cell { flex-direction: row; align-items: center; height: 44px; overflow: hidden; }
.asset-check .resource-cell > Toggle { width: 18px; margin-left: 5px; margin-right: 2px; flex-shrink: 0; }
.asset-check .resource-cell > Button { width: 20px; padding: 0; margin: 0; flex-shrink: 0; background-color: transparent; border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; color: var(--ac-muted); }
.asset-check .resource-thumbnail { width: 32px; height: 32px; min-width: 32px; flex-shrink: 0; margin: 0 4px; background-color: #777777; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: var(--ac-line); border-bottom-color: var(--ac-line); border-left-color: var(--ac-line); border-right-color: var(--ac-line); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; }
.asset-check .resource-text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.asset-check .resource-text > Label { overflow: hidden; text-overflow: ellipsis; margin: 0 5px; color: var(--ac-text); }
.asset-check .resource-text > #name { -unity-font-style: bold; }
.asset-check .resource-text > #path { color: var(--ac-muted); font-size: 10px; margin-top: 2px; }
.asset-check .resource-cell.child { padding-left: 32px; }
.asset-check .resource-cell.preview-row.child { padding-left: 72px; }
.asset-check .resource-cell.child #name { -unity-font-style: normal; color: var(--ac-muted); }
.asset-check .resource-cell.unknown-group #name { color: var(--ac-muted); }
.asset-check .row-actions { flex-direction: row; align-items: center; height: 44px; padding-left: 4px; }
.asset-check .row-actions > Button { margin-right: 2px; }
.asset-check .row-actions > #fix { color: var(--ac-accent); background-color: transparent; border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; padding-left: 5px; padding-right: 5px; }
.asset-check .row-actions > #fix:hover { background-color: var(--ac-surface); }
.asset-check .row-actions > #ignore { padding: 0 8px; -unity-text-align: middle-center; }
.asset-check .column-sort { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 23px; margin: 0; padding: 0 7px; -unity-text-align: middle-left; background-color: transparent; color: var(--ac-text); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; }
.asset-check .column-sort:hover { background-color: var(--ac-surface); }
.asset-check .column-sort.sorted { color: var(--ac-accent); }
.asset-check .resource-text:hover > #name { color: var(--ac-accent); }
.asset-check .empty-results { flex-grow: 1; -unity-text-align: middle-center; color: var(--ac-muted); font-size: 13px; }
.asset-check .ignored-section { margin: 5px 12px; flex-shrink: 0; }
.asset-check .ignored-row { flex-direction: row; align-items: center; padding-left: 5px; padding-right: 3px; }
.asset-check .summary { flex-grow: 1; min-width: 0; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.asset-check .operation-error { white-space: normal; color: rgb(215, 100, 85); margin: 2px 12px; flex-shrink: 0; }
.asset-check .footer { flex-direction: row; align-items: center; margin: 4px 12px; height: 26px; flex-shrink: 0; }
.asset-check .footer > .summary { flex-shrink: 1; color: var(--ac-muted); font-size: 11px; }
.asset-check .footer > Button { flex-shrink: 0; }
.asset-check .format-standard { width: 340px; margin-right: 14px; margin-bottom: 6px; }
.asset-check .format-options { flex-direction: row; flex-wrap: wrap; }
.asset-check .format-options > Toggle { width: 106px; }
